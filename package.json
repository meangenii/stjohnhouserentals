{
  "name": "genericcms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "assert:no-legacy-vendor": "node ./scripts/assert-no-legacy-vendor.cjs",
    "audit:property-template": "node ./scripts/audit-property-template-parity.mjs",
    "content:generate": "node ./scripts/generate-content-artifacts.mjs",
    "dev": "npm run content:generate && vite",
    "seo:generate": "node ./scripts/generate-seo-files.mjs",
    "build": "npm run content:generate && vite build && npm run seo:generate",
    "check": "npm run lint && npm run test:block-contract && npm run test:block-content-contract && npm run test:block-schema && npm run test:block-defaults && npm run test:block-migrations && npm run test:block-tree && npm run test:block-anchors && npm run test:server-block-anchors && npm run test:block-row-layout && npm run test:block-style && npm run test:block-responsive && npm run test:block-inspector-schema && npm run test:block-inspector-interactions && npm run test:block-authoring-coverage && npm run test:block-image-value && npm run test:block-content-audit && npm run test:block-accessibility && npm run test:rich-text-sanitizer && npm run test:link-records && npm run test:page-routes && npm run test:server-page-routes && npm run test:page-diff && npm run test:page-revisions && npm run test:page-editor-history && npm run test:page-editor-validation && npm run test:page-validation-issues && npm run test:editor-interactions && npm run test:editor-visual && npm run build && npm run lint:functions && npm run assert:no-legacy-vendor",
    "check:editor-release": "npm run check && npm run test:editor-api-emulator",
    "deploy": "npm run build && firebase deploy --only hosting,functions",
    "deploy:functions": "npm run content:generate && firebase deploy --only functions",
    "deploy:staging": "node ./scripts/deploy-staging-preview.mjs",
    "deploy:firestore": "firebase deploy --only firestore",
    "deploy:storage": "firebase deploy --only storage",
    "emulators": "npm run content:generate && firebase emulators:start",
    "firebase:doctor": "node ./scripts/firebase-doctor.cjs",
    "lint": "eslint .",
    "lint:functions": "npm run content:generate && npm --prefix functions run lint",
    "test:block-schema": "node ./functions/scripts/test-block-page-schema.js",
    "test:block-contract": "node ./scripts/test-block-contract.mjs",
    "test:block-content-contract": "node ./scripts/test-block-content-contract.mjs",
    "test:block-defaults": "node ./scripts/test-block-defaults.mjs",
    "test:block-migrations": "node ./scripts/test-block-migrations.mjs",
    "test:block-content-audit": "node ./scripts/test-block-content-audit.mjs",
    "test:block-accessibility": "node ./scripts/test-block-accessibility-audit.mjs",
    "test:block-anchors": "node ./scripts/test-block-anchors.mjs",
    "test:block-inspector-schema": "node ./scripts/test-block-inspector-schema.mjs",
    "test:block-inspector-interactions": "node ./scripts/test-block-inspector-interactions.mjs",
    "test:block-authoring-coverage": "node ./scripts/test-block-authoring-coverage.mjs",
    "test:block-image-value": "node ./scripts/test-block-image-value.mjs",
    "test:block-responsive": "node ./scripts/test-block-responsive.mjs",
    "test:block-row-layout": "node ./scripts/test-block-row-layout.mjs",
    "test:block-style": "node ./scripts/test-block-style.mjs",
    "test:block-tree": "node ./scripts/test-block-tree.mjs",
    "test:server-block-anchors": "node ./functions/scripts/test-block-anchors.js",
    "test:rich-text-sanitizer": "node ./scripts/test-rich-text-sanitizer.mjs",
    "test:link-records": "node ./scripts/test-link-records.mjs",
    "test:page-routes": "node ./scripts/test-page-route-settings.mjs",
    "test:server-page-routes": "node ./functions/scripts/test-structured-page-routes.js",
    "test:page-diff": "node ./scripts/test-page-diff.mjs",
    "test:page-revisions": "node ./functions/scripts/test-site-content-revision-history.js",
    "test:page-editor-history": "node ./scripts/test-page-editor-history.mjs",
    "test:page-editor-validation": "node ./scripts/test-page-editor-validation.mjs",
    "test:page-validation-issues": "node ./scripts/test-page-validation-issues.mjs",
    "test:editor-interactions": "node ./scripts/test-page-editor-interactions.mjs",
    "test:editor-visual": "playwright test --config=playwright.editor.config.js --workers=1",
    "test:editor-api-emulator": "node ./scripts/run-editor-api-emulator-test.mjs",
    "perf:audit": "node ./scripts/audit-performance.mjs",
    "media:migrate": "node ./scripts/migrate-legacy-media.mjs",
    "analyze:listings": "node ./scripts/analyze-rental-listing-patterns.mjs",
    "preview": "vite preview",
    "seed:firebase-data": "node ./scripts/seed-firebase-data.mjs",
    "backup:firebase-data": "node ./scripts/backup-firebase-data.mjs",
    "restore:firebase-data": "node ./scripts/restore-firebase-data.mjs",
    "import:firebase-data": "node ./scripts/import-firebase-data.mjs",
    "export:firebase-json": "node ./scripts/export-firebase-json.mjs",
    "import:firebase-json": "node ./scripts/import-firebase-json.mjs",
    "firebase:doctor:recovery": "node ./scripts/firebase-recovery-doctor.mjs",
    "snapshot:site": "node ./scripts/snapshot-live-site.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.14.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "cheerio": "^1.2.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.19.0",
    "globals": "^17.5.0",
    "playwright": "^1.61.1",
    "vite": "^8.0.10"
  },
  "overrides": {
    "cheerio": {
      "undici": "^7.29.0"
    }
  }
}

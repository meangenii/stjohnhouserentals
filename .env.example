VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Set true only if you intentionally want GA events from localhost.
VITE_ENABLE_ANALYTICS_IN_DEV=false
# Server-side GA4 reporting for admin property analytics.
GOOGLE_ANALYTICS_PROPERTY_ID=
# Comma-separated list of Google account emails allowed to sign in as admin
VITE_ADMIN_EMAILS=
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Localhost-only admin convenience. Do not deploy real values.
VITE_ADMIN_AUTO_LOGIN_EMAIL=
VITE_ADMIN_AUTO_LOGIN_PASSWORD=
VITE_API_BASE_URL=/api
VITE_SITE_CONTENT_SOURCE=firebase
VITE_PROPERTY_DATA_SOURCE=firebase
VITE_CHARTER_DATA_SOURCE=firebase

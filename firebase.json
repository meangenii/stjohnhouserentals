{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "st-john-house-rentals",
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/admin",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/social-preview.jpg",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "siteSeo",
          "region": "us-central1"
        }
      },
      {
        "source": "/robots.txt",
        "function": {
          "functionId": "siteSeo",
          "region": "us-central1"
        }
      },
      {
        "source": "/llms.txt",
        "function": {
          "functionId": "siteSeo",
          "region": "us-central1"
        }
      },
      {
        "source": "/rental-properties/**",
        "function": {
          "functionId": "siteSeo",
          "region": "us-central1"
        }
      },
      {
        "source": "/1bedroom/**",
        "function": {
          "functionId": "siteSeo",
          "region": "us-central1"
        }
      },
      {
        "source": "/charter-boat-rentals/**",
        "function": {
          "functionId": "siteSeo",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/social/**",
        "function": {
          "functionId": "siteApiSocial",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "siteApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/admin",
        "destination": "/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/index.html"
      },
      {
        "source": "!/@(assets|admin|api)/**",
        "function": {
          "functionId": "siteSeo",
          "region": "us-central1"
        }
      },
      {
        "source": "!/@(assets)/**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}

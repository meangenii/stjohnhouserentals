ADMIN_ALLOWED_EMAILS=you@example.com
ADMIN_OWNER_EMAILS=you@example.com
# Numeric GA4 property id used by admin property reports and invoice snapshots.
GOOGLE_ANALYTICS_PROPERTY_ID=
SITE_API_CORS_ORIGINS=
FIRESTORE_DATABASE_ID=
FIRESTORE_LIVE_DATABASE_ID=
FIRESTORE_STAGING_DATABASE_ID=
FIRESTORE_ENFORCE_NON_DEFAULT=false
FIRESTORE_BACKUP_OUTPUT_URI=gs://your-bucket/genericcms-firestore
FIREBASE_HOSTING_SITE_ID=st-john-house-rentals
FIREBASE_STAGING_CHANNEL_ID=staging
FIREBASE_STAGING_CHANNEL_TTL=604800s
SMTP_HOST=mail.stjohnhouserentals.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailbox@stjohnhouserentals.com
SMTP_PASS=replace-with-your-doteasy-mail-password
SMTP_FROM_EMAIL=your-mailbox@stjohnhouserentals.com
SMTP_FROM_NAME=St. John House Rentals
ADVERTISE_INQUIRY_TO_EMAIL=backup@example.com
ADVERTISE_INQUIRY_RATE_LIMIT_MAX=5
ADVERTISE_INQUIRY_RATE_LIMIT_WINDOW_MS=900000
# Facebook Graph API (Meta for Developers) - required for the admin Social
# Media panel to publish posts and read metrics. Create an app at
# developers.facebook.com, then generate a long-lived Page Access Token
# (Graph API Explorer, or a Business Manager System User for one that
# doesn't expire) with pages_show_list, pages_read_engagement, and
# pages_manage_posts scopes for Facebook, plus instagram_basic and
# instagram_content_publish for Instagram. FACEBOOK_PAGE_ID is the numeric
# id of the Facebook Page; INSTAGRAM_BUSINESS_ACCOUNT_ID is the Instagram
# Business/Creator account linked to that same Page. Store the Page Access
# Token as a Firebase secret with:
# firebase functions:secrets:set FACEBOOK_PAGE_ACCESS_TOKEN
# For local emulators, put FACEBOOK_PAGE_ACCESS_TOKEN in functions/.secret.local.
# Until these are set, the panel still works for browsing property engagement,
# but publishing is disabled with a clear "not connected" message.
# The FACEBOOK_PAGE_ACCESS_TOKEN secret is only bound to the dedicated
# siteApiSocial/siteApiSocialStaging functions (which serve /api/admin/social/**),
# not the main siteApi/siteApiStaging functions - so it must exist in Secret
# Manager before deploying siteApiSocial(Staging), but the rest of the API
# deploys fine without it.
FACEBOOK_GRAPH_API_VERSION=v21.0
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

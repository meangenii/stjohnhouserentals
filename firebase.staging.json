{
  "hosting": {
    "site": "st-john-house-rentals",
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "firebase.staging.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "siteApiStaging",
          "region": "us-central1",
          "pinTag": true
        }
      },
      {
        "source": "!/@(assets)/**",
        "destination": "/index.html"
      }
    ]
  }
}
